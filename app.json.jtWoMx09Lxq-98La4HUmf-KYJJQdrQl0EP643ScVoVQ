{
  "expo": {
    "name": "ShieldHer",
    "slug": "ShieldHer",
    "version": "1.0.0",
    "orientation": "portrait",
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#3B0764"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ShieldHer records audio evidence during emergencies. Recordings are stored privately on your device.",
        "NSLocationWhenInUseUsageDescription": "ShieldHer uses your location to send your position to trusted contacts during an SOS alert.",
        "NSLocationAlwaysUsageDescription": "ShieldHer can monitor your location during Safe Walk journeys."
      }
    },
    "android": {
      "package": "com.shieldher.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#3B0764"
      },
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_CONTACTS",
        "SEND_SMS",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "9f39e567-e791-4eed-952c-2be9c71a09cf"
      }
    },
    "owner": "joelsb"
  }
}
